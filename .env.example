# Copy to `.env` in the project root. See also `.env.example.api` for API-specific variables.
#
# Tenant bootstrap (required when using multi-tenant Dynamo config):
TENANT_CODE=YOUR_TENANT_CODE
TENANT_BOOTSTRAP_API_URL=https://your-api-gateway-url/default/proacc-tenant-config-api
# TENANT_BOOTSTRAP_API_KEY=your-api-gateway-key-if-required

# Firebird (overwritten by tenant bootstrap when TENANT_CODE is set):
DB_HOST=localhost
DB_USER=sysdba
DB_PASSWORD=YOUR_FIREBIRD_PASSWORD
DB_PATH=

# Flask
FLASK_SECRET_KEY=change-me-for-production
FLASK_HOST=0.0.0.0
FLASK_PORT=8880

# Public URLs (no trailing slash):
BASE_API_URL=http://localhost:8080
APPROVAL_PO_BASE_URL=http://localhost:2095
SUPPLIER_PORTAL_BASE_URL=http://localhost:8880

# AWS (Secrets Manager for tenant credentials):
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
